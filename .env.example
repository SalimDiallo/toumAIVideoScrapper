# Copy to .env and adjust. All vars are optional (sensible defaults apply).
TOUMAI_DATA_DIR=data
TOUMAI_AUDIO_FORMAT=wav
# Dossier bin de ffmpeg (si pas dans le PATH). Vide = on utilise le PATH.
# TOUMAI_FFMPEG_LOCATION=C:\Users\Salim\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin
# Comma / JSON list of preferred caption languages
TOUMAI_LANGUAGES=["fr","en"]

# --- Sélection des sous-titres YouTube ---
# Ordre de confiance : manuel (auteur) > auto-généré (ASR YouTube) > traduit.
# Accepter les sous-titres auto-générés (ASR) de YouTube. false = on ignore l'ASR
# et la vidéo est marquée indisponible plutôt que d'utiliser l'ASR YouTube.
TOUMAI_ACCEPT_YOUTUBE_ASR=true
# En dernier recours, traduire automatiquement une piste vers la langue voulue.
TOUMAI_ENABLE_TRANSCRIPT_TRANSLATION=false

# --- Throttling / anti-blocage des téléchargements (lots CSV de centaines de vidéos) ---
# Téléchargements simultanés max par worker/serveur (2 à 4 conseillé).
TOUMAI_MAX_CONCURRENT_DOWNLOADS=3
# Délai aléatoire (s) avant chaque téléchargement pour espacer les requêtes.
TOUMAI_DOWNLOAD_DELAY_MIN_S=1.0
TOUMAI_DOWNLOAD_DELAY_MAX_S=4.0
# Reprise auto sur HTTP 429 : backoff exponentiel borné + jitter.
TOUMAI_DOWNLOAD_MAX_RETRIES=5
TOUMAI_DOWNLOAD_BACKOFF_BASE_S=2.0
TOUMAI_DOWNLOAD_BACKOFF_MAX_S=300.0
# Proxies / IP de sortie tournants (round-robin). Vide = direct. JSON list.
TOUMAI_DOWNLOAD_PROXIES=[]

# Phase 2 — stockage : local (défaut) ou minio
TOUMAI_STORAGE_BACKEND=local
TOUMAI_MINIO_ENDPOINT=localhost:9000
TOUMAI_MINIO_ACCESS_KEY=minioadmin
TOUMAI_MINIO_SECRET_KEY=minioadmin
TOUMAI_MINIO_BUCKET=toumai-media
TOUMAI_MINIO_SECURE=false

# Phase 2 — catalogue metadata : none (défaut) ou postgres
TOUMAI_METADATA_BACKEND=none
TOUMAI_POSTGRES_DSN=postgresql+psycopg://toumai:toumai@localhost:5432/toumai

# Phase 2 — Kafka (API <-> workers). Pour l'API/worker, activer aussi minio + postgres.
TOUMAI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
TOUMAI_KAFKA_CONSUMER_GROUP=toumai-workers
TOUMAI_TOPIC_JOB_REQUESTED=job.requested
TOUMAI_TOPIC_JOB_COMPLETED=job.completed
TOUMAI_TOPIC_JOB_DLQ=job.dlq
