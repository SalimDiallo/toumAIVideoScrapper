# Copy to .env and adjust. All vars are optional (sensible defaults apply).
TOUMAI_DATA_DIR=data
TOUMAI_AUDIO_FORMAT=wav
# Dossier bin de ffmpeg (si pas dans le PATH). Vide = on utilise le PATH.
# TOUMAI_FFMPEG_LOCATION=C:\Users\Salim\AppData\Local\Microsoft\WinGet\Packages\Gyan.FFmpeg_Microsoft.Winget.Source_8wekyb3d8bbwe\ffmpeg-8.1.2-full_build\bin
# Comma / JSON list of preferred caption languages
TOUMAI_LANGUAGES=["fr","en"]

# --- Sélection des sous-titres YouTube ---
# Ordre de confiance : manuel (auteur) > auto-généré (ASR YouTube) > traduit.
# Accepter les sous-titres auto-générés (ASR) de YouTube. false = on ignore l'ASR
# et la vidéo est marquée indisponible plutôt que d'utiliser l'ASR YouTube.
TOUMAI_ACCEPT_YOUTUBE_ASR=true
# En dernier recours, traduire automatiquement une piste vers la langue voulue.
TOUMAI_ENABLE_TRANSCRIPT_TRANSLATION=false
# Proxy Webshare (IP résidentielles rotatives) pour youtube-transcript-api :
# contourne les bans d'IP ("YouTube is blocking requests from your IP"). Vide =
# direct. Sans Webshare, le pool TOUMAI_DOWNLOAD_PROXIES ci-dessous est réutilisé.
# TOUMAI_WEBSHARE_PROXY_USERNAME=xxxx
# TOUMAI_WEBSHARE_PROXY_PASSWORD=xxxx

# --- Cookies yt-dlp (contourne "Sign in to confirm you're not a bot") ---
# Un SEUL des deux. Navigateur (chrome/firefox/edge/brave, +profil optionnel) :
# TOUMAI_YTDLP_COOKIES_FROM_BROWSER=chrome
# ...ou un fichier cookies.txt exporté (format Netscape) :
# TOUMAI_YTDLP_COOKIES_FILE=C:\Users\Salim\cookies.txt

# --- Throttling / anti-blocage des téléchargements (lots CSV de centaines de vidéos) ---
# Téléchargements simultanés max par worker/serveur (2 à 4 conseillé).
TOUMAI_MAX_CONCURRENT_DOWNLOADS=3
# Délai aléatoire (s) avant chaque téléchargement pour espacer les requêtes.
TOUMAI_DOWNLOAD_DELAY_MIN_S=1.0
TOUMAI_DOWNLOAD_DELAY_MAX_S=4.0
# Reprise auto sur HTTP 429 : backoff exponentiel borné + jitter.
TOUMAI_DOWNLOAD_MAX_RETRIES=5
TOUMAI_DOWNLOAD_BACKOFF_BASE_S=2.0
TOUMAI_DOWNLOAD_BACKOFF_MAX_S=300.0
# Proxies / IP de sortie tournants (round-robin). Vide = direct. JSON list.
TOUMAI_DOWNLOAD_PROXIES=[]

# stockage : local (défaut) ou minio
TOUMAI_STORAGE_BACKEND=local
TOUMAI_MINIO_ENDPOINT=localhost:9000
TOUMAI_MINIO_ACCESS_KEY=minioadmin
TOUMAI_MINIO_SECRET_KEY=minioadmin
TOUMAI_MINIO_BUCKET=toumai-media
TOUMAI_MINIO_SECURE=false
# Endpoint public pour signer les URLs audio remises au NAVIGATEUR. À renseigner
# seulement si le serveur atteint MinIO via un hôte que le navigateur ne résout pas
# (ex. API en conteneur : interne "minio:9000", public "localhost:9000"). Vide en
# mode hôte (make api), où l'endpoint ci-dessus est déjà joignable par le navigateur.
# TOUMAI_MINIO_PUBLIC_ENDPOINT=localhost:9000



# --- Couche SILVER (nettoyage audio bronze -> silver) ---
# Buckets bronze/silver. Vides = on réutilise TOUMAI_MINIO_BUCKET (bucket unique,
# préfixes bronze/ et silver/). Renseigner pour éclater sur deux buckets distincts.
# TOUMAI_MINIO_BUCKET_BRONZE=toumai-media
# TOUMAI_MINIO_BUCKET_SILVER=toumai-media
# Enchaîner le nettoyage silver automatiquement dès qu'un job d'ingestion se termine
# (best-effort ; nécessite storage=minio). Le worker sans demucs retombe sur ffmpeg seul.
TOUMAI_SILVER_AUTO_PROCESS=true
# Moteur de nettoyage : "vad" (Silero VAD + classification d'évènements YAMNet, voir
# package audio_cleaning) ou "ffmpeg" (demucs + silencedetect). Le moteur "vad" retombe
# automatiquement sur "ffmpeg" si ses dépendances manquent (ex. worker léger).
TOUMAI_SILVER_ENGINE=vad
# Backend VAD : "silero" (torch) ou "energy" (repli léger). Classifieur d'évènements :
# "yamnet" (TensorFlow, image silver 3.12), "panns" (torch) ou "heuristic" (aucune dep).
TOUMAI_SILVER_VAD_BACKEND=silero
TOUMAI_SILVER_CLASSIFIER_BACKEND=yamnet
# Seuil de parole du VAD et seuil de confiance pour supprimer un évènement non-parlé.
TOUMAI_SILVER_VAD_THRESHOLD=0.5
TOUMAI_SILVER_EVENT_THRESHOLD=0.7
# Suppression de la musique de fond via demucs (coûteux CPU/GPU). false = on garde
# l'audio d'origine avant la seule découpe des silences.
TOUMAI_SILVER_REMOVE_MUSIC=true
# Couper les passages non-parlés annotés dans le transcript ([Applause], [Musique],
# ♪...) : retire applaudissements et sections musique-seule de l'audio + du transcript.
TOUMAI_SILVER_REMOVE_NONSPEECH=true
# Mots-clés (dans un cue [..]/(..)) marquant un passage non-parlé. JSON list. Vide =
# liste par défaut. Éditable depuis l'UI. Les notes ♪ sont toujours détectées.
# TOUMAI_SILVER_NONSPEECH_KEYWORDS=["applause","musique","rires","instrumental"]
TOUMAI_SILVER_DEMUCS_MODEL=htdemucs
# Détection des silences (ffmpeg silencedetect) : seuil dB + durée minimale (s).
TOUMAI_SILVER_SILENCE_THRESHOLD_DB=-35.0
TOUMAI_SILVER_MIN_SILENCE_S=0.5
# Marge (s) conservée de chaque côté des coupes pour ne pas tronquer les mots.
TOUMAI_SILVER_PADDING_S=0.1

# catalogue metadata : none (défaut) ou postgres
TOUMAI_METADATA_BACKEND=none
TOUMAI_POSTGRES_DSN=postgresql+psycopg://toumai:toumai@localhost:5432/toumai

# Kafka (API <-> workers). Pour l'API/worker, activer aussi minio + postgres.
TOUMAI_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Version d'API Kafka fixée : évite le probing de kafka-python-ng qui plante sous
# Windows/Python 3.14. Ne changer que si le broker est plus ancien.
TOUMAI_KAFKA_API_VERSION=2.5.0
TOUMAI_KAFKA_CONSUMER_GROUP=toumai-workers
# Délai max entre deux poll() avant que le broker éjecte le worker (défaut 30 min).
# Doit couvrir le pire lot : N gros téléchargements + backoff 429.
TOUMAI_KAFKA_MAX_POLL_INTERVAL_MS=1800000
TOUMAI_TOPIC_JOB_REQUESTED=job.requested
TOUMAI_TOPIC_JOB_COMPLETED=job.completed
TOUMAI_TOPIC_JOB_DLQ=job.dlq
